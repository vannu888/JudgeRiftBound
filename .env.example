# Copia questo file in ".env" e inserisci la tua chiave API di Google Gemini.
# La chiave è GRATUITA (senza carta di credito) e si crea qui:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=la-tua-chiave-qui

# (Opzionali) parametri del judge:
# PORT=3000
# JUDGE_MODEL=gemini-2.5-flash        # alt: gemini-2.5-flash-lite (più richieste), gemini-2.5-pro (più bravo)
# JUDGE_THINKING_BUDGET=-1            # -1 = automatico, 0 = niente ragionamento
