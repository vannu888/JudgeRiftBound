# Copia questo file in ".env" e inserisci la tua chiave API Anthropic.
# La chiave si crea su https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opzionali) parametri del judge:
# PORT=3000
# JUDGE_MODEL=claude-opus-5      # es. claude-sonnet-5 per rispondere più in fretta / a costo minore
# JUDGE_EFFORT=high              # low | medium | high | xhigh | max
# JUDGE_MAX_TOKENS=32000
