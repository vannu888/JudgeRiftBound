# Copia questo file in ".env" e inserisci la tua chiave API di Google Gemini.
# La chiave è GRATUITA (senza carta di credito) e si crea qui:
#   https://aistudio.google.com/apikey
# NON scrivere la chiave vera in questo file .env.example: è pubblico su GitHub!
GEMINI_API_KEY=la-tua-chiave-qui

# (Opzionali) parametri del judge:
# PORT=3000
# JUDGE_MODEL=gemini-flash-latest,gemini-flash-lite-latest   # in ordine: se il primo esaurisce la quota si usa il secondo
# JUDGE_THINKING_BUDGET=-1            # -1 = automatico, 0 = niente ragionamento
# JUDGE_TIMEOUT_MS=60000             # timeout se Gemini non risponde

# (Opzionali) se la metti online:
# ACCESS_PASSWORD=una-password-a-scelta  # chiede una password prima di usare il judge
# ASK_RATE_LIMIT=10                      # domande al minuto per dispositivo (0 = nessun limite)
# TRUST_PROXY=1                          # se il server sta dietro un proxy (su Render è automatico)
