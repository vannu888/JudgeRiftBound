{
  "name": "judge-riftbound",
  "version": "1.0.0",
  "description": "Judge virtuale per Rift Bound: ruling in tempo reale sul regolamento ufficiale e sul testo delle carte, con Google Gemini (piano gratuito).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cards": "node scripts/fetch-cards.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "compression": "^1.8.2",
    "dotenv": "^17.0.0",
    "express": "^4.21.2"
  }
}
